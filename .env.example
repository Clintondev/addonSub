NODE_ENV=development
PORT=7000
BASE_URL=http://localhost:7000
REDIS_URL=redis://redis:6379
LIBRETRANSLATE_URL=http://libretranslate:5000
CONTEXTUAL_TRANSLATOR_URL=http://ollama:11434
CONTEXTUAL_TRANSLATOR_MODEL=translategemma:12b
CONTEXTUAL_TRANSLATOR_MAX_CUES=10
CONTEXTUAL_TRANSLATOR_TIMEOUT_SECONDS=300
# Se false, uma falha no tradutor contextual interrompe o job em vez de publicar tradução literal.
ALLOW_LITERAL_TRANSLATION_FALLBACK=false
INTELLIGENCE_URL=http://intelligence:8000
FORCED_ALIGNMENT_ENABLED=true
FORCED_ALIGNMENT_TIMEOUT_MINUTES=120
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_VAD_THRESHOLD=0.35
WHISPER_VAD_MIN_SPEECH_MS=120
WHISPER_VAD_MIN_SILENCE_MS=700
WHISPER_VAD_SPEECH_PAD_MS=500
WHISPER_BEAM_SIZE=5
QBITTORRENT_URL=http://qbittorrent:8080
STORAGE_DIR=./storage
MAX_STORAGE_GB=100
TORRENT_METADATA_TIMEOUT_SECONDS=180
TORRENT_DOWNLOAD_TIMEOUT_MINUTES=720
TORRENT_NO_PROGRESS_TIMEOUT_SECONDS=180

# Formato: Nome|URL do manifest. Separe vários upstreams com vírgula.
UPSTREAM_ADDONS=Torrentio|https://torrentio.strem.fun/manifest.json

# Gere valores longos e aleatórios antes de publicar o serviço.
SUBTITLE_TOKEN_SECRET=change-me
ADMIN_TOKEN=change-me
SIGNED_URL_TTL_SECONDS=86400
UPSTREAM_TIMEOUT_MS=12000
JOB_CONCURRENCY=2
JOB_RATE_LIMIT=4
JOB_LOCK_DURATION_MS=3600000
SERIES_PREFETCH_ENABLED=true
# Mantém o episódio atual mais quatro seguintes preparados.
SERIES_PREFETCH_AHEAD=4
SERIES_PREFETCH_PRIORITY=20
SERIES_PREFETCH_COOLDOWN_MINUTES=5
SERIES_METADATA_CACHE_HOURS=24
CINEMETA_URL=https://v3-cinemeta.strem.io
TARGET_LOCALE=pt-BR
PREFERRED_SUB_LANGS=pob,pt-br,pb,por,pt,eng,en,spa,fra,ita
TRANSLATE_BATCH_CHARS=3500

# Reprodução compatível com navegadores. NVENC é usado quando a GPU está disponível.
HLS_SEGMENT_SECONDS=4
HLS_START_TIMEOUT_SECONDS=45
HLS_VIDEO_BITRATE_KBPS=5000
HLS_AUDIO_BITRATE_KBPS=192
HLS_MAX_HEIGHT=1080
HLS_MAX_CONCURRENT=1
HLS_CACHE_MAX_AGE_HOURS=72
